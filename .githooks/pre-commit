#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Pre-commit — fast checks on staged frontend files only.
#
# Runs ESLint + Prettier --check on your staged files, plus a project-wide
# TypeScript type-check (tsc has no cheaper single-file mode — type inference
# is whole-project by nature, but it's still fast enough for a commit-time
# check on this codebase). None of these auto-fix and re-stage for you —
# they fail loudly and tell you the exact command to run, so you always
# know what's actually being committed. Full production build + test suite
# runs at push time instead — see .githooks/pre-push.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info()    { echo -e "${GREEN}→${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
die()     { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
APP_DIR="$REPO_ROOT/ClaudyGodWebApp"
cd "$REPO_ROOT"

# Filter with a bash case pattern rather than a git pathspec glob — git's `**`
# pathspec matching needs --glob-pathspecs/core.globPathspecs to behave as
# expected, which isn't guaranteed on every machine. Plain `case` matching
# is portable and does the same job here. Uses a `while read` loop instead of
# `mapfile` — macOS ships bash 3.2 by default, which predates mapfile (bash 4+).
STAGED_APP_FILES=()
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  case "$f" in
    ClaudyGodWebApp/*.ts|ClaudyGodWebApp/*.tsx|ClaudyGodWebApp/*.js|ClaudyGodWebApp/*.jsx)
      STAGED_APP_FILES+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#STAGED_APP_FILES[@]} -eq 0 ]]; then
  info "No staged frontend files — skipping."
  exit 0
fi

# Git hooks run with a leaner PATH than your interactive shell. If node/npm is
# managed by nvm, it's normally only put on PATH by ~/.zshrc sourcing nvm.sh —
# which non-login processes (like this hook) don't do. Source it directly;
# if that's not how node is installed, fall back to asking your actual
# login+interactive shell what its real PATH is.
find_node() {
  command -v npm >/dev/null 2>&1 && return 0

  if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.nvm/nvm.sh"
    nvm use default >/dev/null 2>&1 || nvm use node >/dev/null 2>&1 || true
  fi
  command -v npm >/dev/null 2>&1 && return 0

  local user_shell raw shell_path
  user_shell="${SHELL:-/bin/zsh}"
  raw="$("$user_shell" -ilc 'echo "@@PATH_START@@${PATH}@@PATH_END@@"' 2>/dev/null || true)"
  shell_path="$(echo "$raw" | sed -n 's/.*@@PATH_START@@\(.*\)@@PATH_END@@.*/\1/p')"
  if [[ -n "$shell_path" ]]; then
    export PATH="$shell_path:$PATH"
  fi

  command -v npm >/dev/null 2>&1
}

if ! find_node; then
  die "npm not found — checked \$HOME/.nvm and even asked \$SHELL (${SHELL:-unset}) for its real PATH, with no luck. Run 'which npm' in your terminal and paste it back so it can be hardcoded into find_node(). To skip this check just once: git commit --no-verify."
fi

if [[ ! -d "$APP_DIR/node_modules" ]]; then
  die "node_modules not found in ClaudyGodWebApp/ — run 'npm install' there first."
fi

# Paths relative to ClaudyGodWebApp/, since that's where eslint/prettier/tsc run from.
RELATIVE_FILES=()
for f in "${STAGED_APP_FILES[@]}"; do
  RELATIVE_FILES+=("${f#ClaudyGodWebApp/}")
done

cd "$APP_DIR"

info "Linting ${#RELATIVE_FILES[@]} staged file(s)..."
if ! npx eslint "${RELATIVE_FILES[@]}"; then
  die "ESLint found errors. Fix them (or run 'npx eslint --fix <file>' inside ClaudyGodWebApp/), re-stage, and commit again."
fi

info "Checking formatting..."
if ! npx prettier --check "${RELATIVE_FILES[@]}"; then
  die "Formatting issues found. Run 'npx prettier --write <file>' inside ClaudyGodWebApp/, review the diff, re-stage, and commit again."
fi

info "Type-checking (whole project)..."
if ! npm run type-check --silent; then
  die "TypeScript errors found. Fix them before committing."
fi

success "Lint, format, and type-check all passed."
