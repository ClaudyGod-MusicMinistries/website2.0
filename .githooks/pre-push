#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Pre-push — thorough check: full production build + full test suite.
#
# This is the last line of defense before code leaves your machine. `npm run
# build` catches everything a production build would catch (type errors,
# broken imports, invalid routes) that a dev server silently tolerates.
# `npm test` runs whatever test suite is configured — currently a placeholder
# in this repo, so it's a no-op today, but the hook picks up real tests
# automatically the moment any are added, with no hook changes needed.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

GREEN='\033[0;32m'; RED='\033[0;31m'; NC='\033[0m'
info()    { echo -e "${GREEN}→${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
die()     { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

# Git hooks run with a leaner PATH than your interactive shell. If node/npm is
# managed by nvm, it's normally only put on PATH by ~/.zshrc sourcing nvm.sh —
# which non-login processes (like this hook) don't do. Source it directly;
# if that's not how node is installed, fall back to asking your actual
# login+interactive shell what its real PATH is.
find_node() {
  command -v npm >/dev/null 2>&1 && return 0

  if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.nvm/nvm.sh"
    nvm use default >/dev/null 2>&1 || nvm use node >/dev/null 2>&1 || true
  fi
  command -v npm >/dev/null 2>&1 && return 0

  local user_shell raw shell_path
  user_shell="${SHELL:-/bin/zsh}"
  raw="$("$user_shell" -ilc 'echo "@@PATH_START@@${PATH}@@PATH_END@@"' 2>/dev/null || true)"
  shell_path="$(echo "$raw" | sed -n 's/.*@@PATH_START@@\(.*\)@@PATH_END@@.*/\1/p')"
  if [[ -n "$shell_path" ]]; then
    export PATH="$shell_path:$PATH"
  fi

  command -v npm >/dev/null 2>&1
}

if ! find_node; then
  die "npm not found — checked \$HOME/.nvm and even asked \$SHELL (${SHELL:-unset}) for its real PATH, with no luck. Run 'which npm' in your terminal and paste it back so it can be hardcoded into find_node(). To skip this check just once: git push --no-verify."
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
APP_DIR="$REPO_ROOT/ClaudyGodWebApp"

if [[ ! -d "$APP_DIR/node_modules" ]]; then
  die "node_modules not found in ClaudyGodWebApp/ — run 'npm install' there first."
fi

cd "$APP_DIR"

info "Building (production)..."
if ! npm run build; then
  die "Build failed. Fix the errors above before pushing."
fi

info "Running test suite..."
if ! npm test; then
  die "Tests failed. Fix the failing tests above before pushing."
fi

success "Build and tests passed — pushing."
