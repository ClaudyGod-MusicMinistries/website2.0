{
  "name": "claudygod-webapp",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run verify:runtime && npm run type-check && npm run lint && npm test && npm run build",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "contract:backend": "node scripts/verify-backend-contract.mjs",
    "validate:env": "bash scripts/validate-env.sh",
    "verify:backend-contract": "node scripts/verify-backend-contract.mjs",
    "setup:security": "bash scripts/setup-security.sh",
    "seed:content": "tsx scripts/seed-content.ts",
    "setup-hooks": "bash scripts/install-git-hooks.sh",
    "prepare": "npm run setup-hooks"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.441.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.52.1",
    "react-icons": "^5.2.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.24",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.9 <25"
  }
}
