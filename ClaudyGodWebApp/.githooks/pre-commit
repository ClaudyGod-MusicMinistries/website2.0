#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HOOK_DIR/lib/ui.sh"
hook_header "PRE-COMMIT  Fast staged-code review"

repo_root="$(git rev-parse --show-toplevel)"
app_root="$repo_root/ClaudyGodWebApp"
cd "$repo_root"

git diff --cached --check || die "Fix staged whitespace errors or conflict markers."

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[[ -z "$staged" ]] && { hook_success "No staged files to check."; exit 0; }

if git diff --cached -- . ':(exclude)ClaudyGodWebApp/.githooks/pre-commit' |
  grep -E '^\+.*(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|sk_live_[0-9A-Za-z]+|NEXT_PUBLIC_.*(SECRET|TOKEN|PASSWORD))' >/dev/null; then
  die "Possible secret detected. Browser-exposed NEXT_PUBLIC variables must never contain credentials."
fi

files=()
while IFS= read -r file; do
  case "$file" in
    ClaudyGodWebApp/*.ts|ClaudyGodWebApp/*.tsx|ClaudyGodWebApp/*.js|ClaudyGodWebApp/*.mjs|ClaudyGodWebApp/*.json|ClaudyGodWebApp/*.css|ClaudyGodWebApp/*.md|.github/*.yml|.github/*.yaml)
      files+=("$repo_root/$file") ;;
  esac
done <<< "$staged"

[[ ${#files[@]} -eq 0 ]] && { hook_success "Repository hygiene checks passed."; exit 0; }

cd "$app_root"
HOOK_FAILURE_HINT="Run Prettier, review the result, and re-stage the files."
run_step "Prettier (${#files[@]} staged files)" npx prettier --check "${files[@]}"

lint_files=()
for file in "${files[@]}"; do
  [[ "$file" =~ \.(js|mjs|ts|tsx)$ ]] && lint_files+=("$file")
done
if [[ ${#lint_files[@]} -gt 0 ]]; then
  run_step "ESLint (${#lint_files[@]} staged source files)" npx eslint --max-warnings=0 "${lint_files[@]}"
fi

hook_success "Commit approved."
