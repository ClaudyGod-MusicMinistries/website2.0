#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; NC='\033[0m'
die() { printf "${RED}✗ %s${NC}\n" "$*" >&2; exit 1; }
ok() { printf "${GREEN}✓ %s${NC}\n" "$*"; }

repo_root="$(git rev-parse --show-toplevel)"
app_root="$repo_root/ClaudyGodWebApp"
cd "$repo_root"

git diff --cached --check || die "Fix staged whitespace errors or conflict markers."

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[[ -z "$staged" ]] && { ok "No staged files to check."; exit 0; }

if git diff --cached -- . ':(exclude)ClaudyGodWebApp/.githooks/pre-commit' |
  grep -E '^\+.*(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|sk_live_[0-9A-Za-z]+|NEXT_PUBLIC_.*(SECRET|TOKEN|PASSWORD))' >/dev/null; then
  die "Possible secret detected. Browser-exposed NEXT_PUBLIC variables must never contain credentials."
fi

files=()
while IFS= read -r file; do
  case "$file" in
    ClaudyGodWebApp/*.ts|ClaudyGodWebApp/*.tsx|ClaudyGodWebApp/*.js|ClaudyGodWebApp/*.mjs|ClaudyGodWebApp/*.json|ClaudyGodWebApp/*.css|ClaudyGodWebApp/*.md|.github/*.yml|.github/*.yaml)
      files+=("$repo_root/$file") ;;
  esac
done <<< "$staged"

[[ ${#files[@]} -eq 0 ]] && { ok "Repository hygiene checks passed."; exit 0; }

cd "$app_root"
npx prettier --check "${files[@]}" || die "Formatting failed. Run npm run format, review, and re-stage."

lint_files=()
for file in "${files[@]}"; do
  [[ "$file" =~ \.(js|mjs|ts|tsx)$ ]] && lint_files+=("$file")
done
if [[ ${#lint_files[@]} -gt 0 ]]; then
  npx eslint --max-warnings=0 "${lint_files[@]}" || die "ESLint failed."
fi

ok "Staged security, formatting, and lint checks passed."
