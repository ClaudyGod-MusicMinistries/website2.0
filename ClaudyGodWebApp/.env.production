# Production Environment - Template
# This file is the production template. Docker will use this if .env is missing.
# DO NOT commit .env (local environment overrides) to version control.

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://claudygod.org

# The server-side proxy (lib/data/backendProxy.ts) reads API_BASE_URL — NOT
# NEXT_PUBLIC_API_URL. That name was set here and in the CI workflow/Dockerfile
# build args instead, so it was never actually read by the running server,
# which silently fell back to its http://localhost:8080 default and made every
# /api/* call fail with a 502 "fetch failed". Confirm this is the correct
# backend host before deploying — DEPLOY.md references webApi.claudygod.org
# elsewhere, which doesn't match this domain; pick one and make every
# reference (here, Dockerfile ARG default, GitHub Actions variable) agree.
API_BASE_URL=https://api.claudygod.org

# Required so the proxy's server-to-server calls to the .NET backend carry
# the x-api-key header its ApiKeyMiddleware expects — without this, every
# proxied call is rejected by the backend. Must match a key the backend
# actually accepts (see CGM-Backend's own INTERNAL_API_KEY config).
INTERNAL_API_KEY=internal_key_xxxxxxxxxxxxxxxxxxxxx

# Required by requireApiKey()/validateApiKey() (middleware/apiKeyValidator.ts),
# currently enforced only on app/api/media/youtube/[videoId]/route.ts —
# without this, that specific route rejects every request as unauthorized.
VALID_API_KEYS=key1_xxxxxxxxxxxxx,key2_xxxxxxxxxxxxx

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_placeholder
PAYSTACK_SECRET_KEY=sk_live_placeholder
